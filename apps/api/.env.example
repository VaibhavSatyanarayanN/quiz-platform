# Application Environment
NODE_ENV=development
PORT=3000

# CORS Allowed Origins (comma-separated list)
# Default for development: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (TypeORM / PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=quiz_user
DB_PASSWORD=quiz_password
DB_DATABASE=quiz_platform
DATABASE_URL=postgresql://quiz_user:quiz_password@localhost:5432/quiz_platform?schema=public

# Redis / BullMQ Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_secure_random_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Authentication Rate Limiting (Brute-force protection on /auth/login and /auth/register)
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=10

# AI Service Integration (FastAPI multi-agent service)
# In production, must be HTTPS unless communicating with localhost or an internal container (e.g., http://ai:8000)
AI_SERVICE_URL=http://127.0.0.1:8000
# AI request timeout in milliseconds (default: 180000 = 3 minutes for multi-agent synthesis)
AI_SERVICE_TIMEOUT_MS=180000

# Rate Limiting & Abuse Prevention for AI Endpoints (in-memory per replica)
AI_RATE_LIMIT_TTL_SECONDS=60
AI_RATE_LIMIT_MAX=5
